# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/debate-platform

# Auth: use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (only needed if the client is hosted separately)
CLIENT_URL=http://localhost:5173

# Required to register as an Organizer. Share it only with people who should create debates.
ORGANIZER_INVITE_CODE=organizer-secret-code
